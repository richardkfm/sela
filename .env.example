POSTGRES_USER=sela
POSTGRES_PASSWORD=sela
POSTGRES_DB=sela
DATABASE_URL=postgresql://sela:sela@db:5432/sela

# Basemap archive (ADR-0003, ingest/basemap/build.sh). Optional — if unset
# or the file doesn't exist, the app serves a flat ground-colour style with
# no basemap source instead of failing (lib/basemap/pmtiles-reader.ts).
PMTILES_PATH=data/basemap/pilot.pmtiles

# Which basemap to serve (lib/basemap/basemap-source.ts):
#   auto (default) — the PMTiles archive above if present, else basemap.de
#   pmtiles        — the archive only; flat ground colour if it is absent
#   basemapde      — BKG basemap.de WMTS, CC BY 4.0, no account needed
#   carto          — CARTO; WATERMARKS every tile unless SELA_CARTO_API_KEY is set
#   none           — flat ground colour, no basemap
# The remote options are a development fallback while ingest/basemap/build.sh
# cannot reach Geofabrik. ADR-0003 still calls for a self-hosted archive before
# anything public ships.
SELA_BASEMAP=auto
# SELA_CARTO_API_KEY=

# Initial map view (app/(map)/Map.tsx). Defaults to the real pilot region;
# set to `fixture` for the 0.3.0 synthetic view at null island (0,0).
# NEXT_PUBLIC_MAP_VIEW=fixture
