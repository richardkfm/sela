# GDAL-based, run-once ingest container (ADR-0002). Not long-lived: it runs
# ingest/run.sh and exits, invoked via `docker compose --profile ingest run
# --rm ingest` (add `--fixture` for the synthetic dev/test path — see
# ingest/fixtures/README.md). GDAL provides ogr2ogr/gdalwarp; jq and
# postgresql-client are added for the pipeline's manifest check and SQL
# steps (roadmap §4.2).
#
# Ubuntu 24.04 with its own GDAL (3.8.4), PostGIS tools (3.4.2) and
# postgresql-client-16 — the same packages the Uckermark pipeline was verified
# with. Built and run end to end on 2026-09-28 (roadmap Step 6). The earlier
# base, ghcr.io/osgeo/gdal:alpine-small-3.9.2, could not work: `apk add
# postgis` (needed for raster2pgsql) replaces the image's PROJ with Alpine's
# older one, and every GDAL tool then fails with "Error relocating
# /usr/lib/libgdal.so.35: proj_coordinate_metadata_create: symbol not found".
# One distribution for GDAL, PROJ and PostGIS avoids mixing their libraries.

FROM ubuntu:24.04

# postgis supplies raster2pgsql (ingest/real/12_dwd.sh, 13_dgm200.sh); unzip
# unpacks the archives; curl fetches them (01_fetch.sh).
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
       gdal-bin postgis postgresql-client-16 jq unzip curl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /ingest
COPY ingest/ .
RUN chmod +x *.sh real/*.sh

ENTRYPOINT ["./run.sh"]
