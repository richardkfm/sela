# GDAL-based, run-once ingest container (ADR-0002). Not long-lived: it runs
# ingest/run.sh and exits, invoked via `docker compose --profile ingest run
# ingest` (add `-- --fixture` for the synthetic dev/test path — see
# ingest/fixtures/README.md). GDAL provides ogr2ogr/gdalwarp; jq and
# postgresql-client are added for the pipeline's manifest check and SQL
# steps (roadmap §4.2).

FROM ghcr.io/osgeo/gdal:alpine-small-3.9.2

# postgis supplies raster2pgsql (ingest/real/12_dwd.sh, 13_dgm200.sh); unzip
# unpacks the DWD annual grids. NOT verified by a docker build yet — the
# environment that added these (2026-09-23) had no Docker daemon; the real
# pipeline was run against a local PostGIS with the same tools instead.
RUN apk add --no-cache jq postgresql-client postgis unzip curl

WORKDIR /ingest
COPY ingest/ .
RUN chmod +x *.sh real/*.sh

ENTRYPOINT ["./run.sh"]
